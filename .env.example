# ============================================================
# Node Microservices - Environment Variables
# ============================================================
# Generated so `docker compose up --build` works immediately from a
# fresh clone. These are real, usable values for LOCAL DEVELOPMENT
# ONLY -- rotate JWT_SECRET, GATEWAY_SECRET, and every *_PASSWORD
# below before deploying anywhere real.
# ============================================================

# ------------------------------------------------------------
# Database (PostgreSQL) -- must stay consistent with the db service's
# POSTGRES_USER/PASSWORD/DB in docker-compose.yml
# ------------------------------------------------------------
DATABASE_URL=postgres://postgres:postgres@db:5432/nodems

# ------------------------------------------------------------
# Auth
# ------------------------------------------------------------
JWT_SECRET=950fefb6aa5b7f81e9472817c7c04fdc82ed1abb558fb491d87f7591b5c6d85d
JWT_EXPIRES_IN=1d
# Shared secret the gateway attaches to every proxied request; each
# downstream service's requireGatewaySecret middleware checks this so
# they only accept traffic that actually came through the gateway.
GATEWAY_SECRET=950fefb6aa5b7f81e9472817c7c04fdc82ed1abb558fb491d87f7591b5c6d85d

# ------------------------------------------------------------
# Kafka
# ------------------------------------------------------------
KAFKA_BROKERS=kafka:29092

# ------------------------------------------------------------
# Object storage (MinIO -- a local, S3-API-compatible substitute for
# real AWS S3, so image uploads work out of the box with no external
# account needed. Swap AWS_* below for real S3/AWS credentials and
# drop AWS_PUBLIC_URL_S3 to use real AWS instead.)
# ------------------------------------------------------------
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin123
AWS_REGION=us-east-1
STORAGE_BUCKET=support-tasks
# Internal container-to-container endpoint media-service uses to talk
# to MinIO.
AWS_ENDPOINT_URL_S3=http://minio:9000
# Browser-facing base URL for the same bucket, via MinIO's
# host-published port (see media-service/src/utils/stroage.ts -- the
# internal endpoint above isn't reachable from your browser).
AWS_PUBLIC_URL_S3=http://35.225.152.46:9000

# ------------------------------------------------------------
# Logging
# ------------------------------------------------------------
LOG_LEVEL=info

# ------------------------------------------------------------
# Service ports (internal -- also published to the host, see below)
# ------------------------------------------------------------
PORT=3000
AUTH_PORT=3001
TASK_PORT=3002
MEDIA_PORT=3003
WORKFLOW_PORT=3004

# Internal service-to-service URLs the gateway proxies to.
AUTH_SERVICE_URL=http://auth-service:3001
TASK_SERVICE_URL=http://task-service:3002
MEDIA_SERVICE_URL=http://media-service:3003
WORKFLOW_SERVICE_URL=http://workflow-service:3004

# ------------------------------------------------------------
# Frontend (Vite) -- VITE_* values are inlined into the bundle at
# build time (see frontend/Dockerfile's build args)
# ------------------------------------------------------------
VITE_API_BASE_URL=http:/api

# ------------------------------------------------------------
# OpenTelemetry (auto-instrumentation via NODE_OPTIONS -- see the root
# Dockerfile and observability/README.md). OTEL_SERVICE_NAME is set
# per service in docker-compose.yml since all five share this image.
# ------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_METRICS_EXPORTER=prometheus
OTEL_EXPORTER_PROMETHEUS_PORT=9464
OTEL_EXPORTER_PROMETHEUS_HOST=0.0.0.0

# ------------------------------------------------------------
# Ports published to the host
# ------------------------------------------------------------
FRONTEND_PORT=5173
GATEWAY_PORT=3000
POSTGRES_PORT=5432
KAFKA_PORT=9092
KAFKA_UI_PORT=8080
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
GRAFANA_PORT=3001
PROMETHEUS_PORT=9091
ALERTMANAGER_PORT=9093
LOKI_PORT=3100
JAEGER_UI_PORT=16686

# ------------------------------------------------------------
# Grafana
# ------------------------------------------------------------
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=admin
